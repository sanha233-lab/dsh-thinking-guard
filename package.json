{
  "name": "dsh-thinking-guard",
  "version": "1.1.1",
  "description": "DSH 插件的修复版：模型只思考不产出、原地打转时自动打断，并让它继续干活。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/*.js",
    "test",
    "README.md",
    "cordis.patch.yml"
  ],
  "scripts": {
    "test": "node test/guard.test.mjs"
  },
  "author": "Ethan Wong (original), maintained fork by sanha233-lab",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "thinking-guard",
    "circuit-breaker",
    "idle-loop",
    "reasoning-stall"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sanha233-lab/dsh-thinking-guard.git"
  },
  "homepage": "https://github.com/sanha233-lab/dsh-thinking-guard#readme",
  "bugs": {
    "url": "https://github.com/sanha233-lab/dsh-thinking-guard/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "engines": {
    "node": ">=18",
    "dsh": ">=0.1.0"
  }
}
